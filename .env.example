# Copy to .env and fill in real values. Never commit .env.
DB_NAME=copilot
DB_USER=copilot
DB_PASSWORD=copilot

# Generate with: openssl rand -base64 48
JWT_SECRET=

# false only for local http:// dev — must be true (default) behind real TLS
COOKIES_SECURE=false
CORS_ALLOWED_ORIGIN=http://localhost:5173

# anthropic | openai (selects the chat/generation provider)
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Embeddings always go through OpenAI regardless of LLM_PROVIDER — Anthropic has no
# embeddings endpoint (see docs/02-system-design.md, RAG Pipeline Design).
EMBEDDING_API_KEY=

UPLOAD_MAX_SIZE_MB=20
RAG_TOP_K=5
